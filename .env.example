# Copy to .env.local and fill in your Supabase project's public connection values.
# No secret/service_role key is required for user-session access with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: public signing keys endpoint for explicit server-side JWT verification.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# Supabase CLI only: put this variable in root .env, not .env.local.
# Gmail app password for caremypet9173@gmail.com, without spaces.
# Never prefix this secret with NEXT_PUBLIC_.
# SUPABASE_AUTH_SMTP_PASS=REPLACE_WITH_APP_PASSWORD
# Google OAuth web client: also put these in root .env for Supabase CLI.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_ME
