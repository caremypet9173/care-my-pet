# Copy to .env.local and fill in your Supabase project's public connection values.
# No secret/service_role key is required for user-session access with RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional: public signing keys endpoint for explicit server-side JWT verification.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# Web Push (VAPID): public key for client PWA subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY

# Supabase CLI only: put these variables in root .env, not .env.local.
# Used by supabase/config.toml ([auth.email.smtp]) during config diff/push.
# Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_AUTH_SMTP_HOST=smtp.gmail.com
# SUPABASE_AUTH_SMTP_USER=caremypet9173@gmail.com
# SUPABASE_AUTH_SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SUPABASE_AUTH_SMTP_ADMIN_EMAIL=caremypet9173@gmail.com
# SUPABASE_AUTH_SMTP_SENDER_NAME=Care My Pet

# Supabase Edge Functions secrets (set via `supabase secrets set ...`).
# Used by supabase/functions/_shared/smtp.ts (household, household-recovery,
# pet-archive, schedule-notifications). Never prefix with NEXT_PUBLIC_.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=caremypet9173@gmail.com
# SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=noreply@example.com
# SMTP_SENDER_NAME=Care My Pet
# WAITLIST_NOTIFY_EMAIL=admin@example.com
# VAPID_SUBJECT=mailto:admin@example.com

# Google OAuth web client: also put these in root .env for Supabase CLI.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_ME

# Server-side document extraction. Put the key in ignored root .env, then set
# only these variables as Supabase Edge Function secrets. Never NEXT_PUBLIC_.
# GEMINI_API_KEY=REPLACE_ME
# GEMINI_MODEL=gemini-3.1-pro-preview
